# ----------------------------------------------------------------------------
# Trip Planning System - environment configuration
# Copy this file to ".env" and fill in the values you need.
# Only ANTHROPIC_API_KEY is required to run the live agent. Everything else
# has a working mock and is optional.
# ----------------------------------------------------------------------------

# Which LLM backend powers the agent: "claude" (default) or "gemini".
AGENT_PROVIDER=claude

# --- Claude backend (AGENT_PROVIDER=claude) ---
# Powers the Claude Agent SDK (the agent "brain").
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the Claude agent.
AGENT_MODEL=claude-sonnet-4-6

# --- Gemini backend (AGENT_PROVIDER=gemini) ---
# A Google AI Studio API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Master switch. "true" (default) uses in-process mocks for auth, places and
# the vector store so the app runs fully offline. Set to "false" to use the
# real services configured below.
USE_MOCKS=true

# Backend HTTP port.
PORT=8787

# --- Optional: real Firebase Authentication (only read when USE_MOCKS=false) ---
# Path to a Firebase service-account JSON file, or the JSON inline.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# --- Optional: real Google Places API (only read when USE_MOCKS=false) ---
GOOGLE_PLACES_API_KEY=