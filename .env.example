# ----------------------------------------------------------------------------
# Trip Planning System - environment configuration
# Copy this file to ".env" and fill in the values.
# ----------------------------------------------------------------------------

# Which LLM backend powers the agent: "claude" (default) or "gemini".
AGENT_PROVIDER=claude

# --- Claude backend (AGENT_PROVIDER=claude) ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-6

# --- Gemini backend (AGENT_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend HTTP port.
PORT=8787

# --- Google OAuth (used for both login and place search) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Set Authorized JavaScript origins to http://localhost:5173
# Set Authorized redirect URIs to http://localhost:5173
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=
