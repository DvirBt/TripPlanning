# ----------------------------------------------------------------------------
# Trip Planning System - environment configuration
# Copy this file to ".env" and fill in the values.
# ----------------------------------------------------------------------------

# --- Agent backend selection ---
# Default LLM that powers the agent: "gemini" or "openai".
# The model selector in the top-right of the UI overrides this per request.
LLM_PROVIDER=gemini

# --- Agent: Google Gemini (via Google AI Studio) ---
# Create an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Agent: OpenAI / ChatGPT ---
# Create an API key at https://platform.openai.com/api-keys
# gpt-4o-mini is the cheapest capable option; planning fires many calls per turn,
# so avoid gpt-4o unless you have ample credit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend HTTP port.
PORT=8787

# --- Google OAuth (used for both login and place search) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Set Authorized JavaScript origins to http://localhost:5173
# Set Authorized redirect URIs to http://localhost:5173
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=

# --- Google Maps (browser, used by the itinerary map) ---
# Enable "Maps JavaScript API" + "Directions API" in Google Cloud, then create a
# browser key restricted by HTTP referrer (http://localhost:5173 in dev).
# This is exposed to the browser, so keep it referrer-restricted.
VITE_GOOGLE_MAPS_API_KEY=
